# Required
MYSQL_ROOT_PASSWORD=replace_with_strong_mysql_root_password
AUTH_TOKEN_SECRET=replace_with_strong_auth_token_secret
DATABASE_URL=mysql+pymysql://root:replace_with_strong_mysql_root_password@mysql:3306/misspell
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Optional but recommended for first admin bootstrap
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=replace_with_strong_admin_password

# Optional LLM / provider config
DASHSCOPE_API_KEY=
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen-plus
BAILIAN_TIMEOUT_SECONDS=8

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=replace_with_turnstile_site_key
TURNSTILE_SECRET_KEY=replace_with_turnstile_secret_key
TURNSTILE_TIMEOUT_SECONDS=6
# Frontend build-time variable (same value as TURNSTILE_SITE_KEY)
VITE_TURNSTILE_SITE_KEY=replace_with_turnstile_site_key

# Optional GBNC / behavior config
GBNC_BASE_URL=https://books.google.com/ngrams/json
GBNC_TIMEOUT_SECONDS=10
GBNC_RETRIES=1
GBNC_USER_AGENT=misspelling-platform/1.0
ALGO_STRICT_MODE=false
CAPTCHA_TTL_SECONDS=180

# Variant dictionary file inside container
MISSPELL_VARIANT_DICT_PATH=/workspace-root/adversarial_advs_clean_cleaned_completion2.0.json
